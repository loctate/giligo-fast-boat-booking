# ============================================================
# GiliGo / Nusa Gili Boat — Application Environment Example
# ============================================================
# Copy this file to .env.local for local development.
# Never commit real credentials or production secrets.

# ------------------------------------------------------------
# Appwrite — server-side configuration
# ------------------------------------------------------------

APPWRITE_ENDPOINT=https://your-appwrite-domain.example/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

APPWRITE_BOOKINGS_TABLE_ID=
APPWRITE_OPERATORS_TABLE_ID=
APPWRITE_VESSELS_TABLE_ID=
APPWRITE_ROUTES_TABLE_ID=
APPWRITE_TRIP_SCHEDULES_TABLE_ID=
APPWRITE_TRIP_INVENTORY_TABLE_ID=

# ------------------------------------------------------------
# Administrator authentication
# ------------------------------------------------------------

ADMIN_EMAIL=admin@example.com
ADMIN_SESSION_COOKIE=giligo_admin_session

# ------------------------------------------------------------
# Public support contact
# ------------------------------------------------------------
# WhatsApp number should use international format without +,
# spaces, or punctuation. Example: 6281234567890

NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ------------------------------------------------------------
# Temporary seat hold
# ------------------------------------------------------------
# Allowed range: 5–1440 minutes.
# Default application value: 30 minutes.

SEAT_HOLD_DURATION_MINUTES=30

# ------------------------------------------------------------
# Expired held-booking cleanup
# ------------------------------------------------------------
# Use a random secret containing at least 32 characters.
# Never expose this value through NEXT_PUBLIC_* variables.

CRON_SECRET=

# ------------------------------------------------------------
# Controlled online-payment verification
# ------------------------------------------------------------
# "enabled" keeps the controlled verification gate active.
# "disabled" removes the verification-code gate for otherwise
# eligible bookings.
#
# Generate a SHA-256 hash, for example:
# printf '%s' 'your-verification-code' | sha256sum

PAYMENT_VERIFICATION_MODE=enabled
PAYMENT_VERIFICATION_CODE_HASH=

# ------------------------------------------------------------
# Public application URL
# ------------------------------------------------------------
# Required by the controlled payment flow.
# The payment integration requires an HTTPS URL.

NUSAGILIBOAT_PUBLIC_BASE_URL=https://your-public-domain.example

# ------------------------------------------------------------
# iPaymu Bridge connection
# ------------------------------------------------------------
# These values connect the Next.js application to the isolated
# server-side iPaymu Bridge.
#
# Provider credentials belong in:
# services/ipaymu-bridge/config.example.env

IPAYMU_BRIDGE_URL=https://your-bridge-domain.example/ipaymu-bridge/
IPAYMU_BRIDGE_INTERNAL_TOKEN=
