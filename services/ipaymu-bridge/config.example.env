# Keep disabled until Sandbox integration is complete.
IPAYMU_ENABLED=false
IPAYMU_ENVIRONMENT=sandbox

# Server-side values only. Never use NEXT_PUBLIC_*.
IPAYMU_API_BASE_URL=
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_BRIDGE_INTERNAL_TOKEN=

# Appwrite server-side values for callback processing.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_BOOKINGS_TABLE_ID=
APPWRITE_TRIP_INVENTORY_TABLE_ID=

HOST=0.0.0.0
PORT=8080
IPAYMU_BRIDGE_PREFIX=/ipaymu-bridge
